{
  "manifest_version": 3,
  "name": "OpenFeed",
  "description": "Your personal feed, served from your own browser",
  "version": "1.26.8",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": ["cookies", "storage"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://x.com/*",
    "https://medium.com/*",
    "https://hackernoon.com/*",
    "https://www.freecodecamp.org/*",
    "https://raw.githubusercontent.com/*",
    "https://lobste.rs/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://x.com/*"],
      "run_at": "document_start",
      "js": ["content-xcom.js"]
    },
    {
      "matches": ["https://claude.ai/*"],
      "run_at": "document_idle",
      "js": ["content-claude.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content-xcom-inject.js"],
      "matches": ["https://x.com/*"]
    }
  ],
  "icons": {
    "16": "/logos/logo16.png",
    "32": "/logos/logo32.png",
    "48": "/logos/logo48.png",
    "128": "/logos/logo128.png"
  }
}
